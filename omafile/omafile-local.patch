     send_done(req_id, outputs=outputs)
 
+LNKR_VARIANTS = ("v1", "v2", "v3", "v4")
+LNKR_MODES = ("rich", "safe", "make")
+
+
+def lnkr_binary_candidates():
+    # Known path first, then a lightweight foldername scan for the rust target.
+    home = HOME
+    candidates = [os.path.join(home, "Documents/Dev/linkoder/bin/linkodec")]
+    for base in (os.path.join(home, "Documents/Dev"),
+                 os.path.join(home, "Documents"),
+                 os.path.join(home, "src"),
+                 home):
+        try:
+            names = os.listdir(base)
+        except OSError:
+            continue
+        if "linkoder" not in names:
+            continue
+        root = os.path.join(base, "linkoder")
+        candidates.append(os.path.join(root, "bin/linkodec"))
+        candidates.append(os.path.join(root, "target/release/linkodec"))
+    return candidates
+
+
+def op_lnkrresolve(req):
+    req_id = req["id"]
+    for candidate in lnkr_binary_candidates():
+        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
+            send_done(req_id, path=candidate)
+            return
+    send_done(req_id, path="")
+
+
+def op_lnkreencode(req):
+    req_id = req["id"]
+    binary = req.get("binary")
+    path = req.get("path")
+    mode = req.get("mode")
+    variant = req.get("variant")
+    if (not isinstance(binary, str) or not os.path.isabs(binary)
+            or not os.path.isfile(binary)
+            or not isinstance(path, str) or not os.path.isabs(path)
+            or mode not in LNKR_MODES
+            or variant not in LNKR_VARIANTS):
+        send_error(req_id, "EINVAL",
+                   "absolute binary and path, a mode (rich, safe, make) and a variant (v1..v4) are required")
+        return
+    if not os.path.isfile(path):
+        send_error(req_id, "ENOENT", "no such file", path)
+        return
+    cmd = [binary, path, "--" + mode, "--" + variant]
+    env = trusted_env()
+    env["PATH"] = os.environ.get("PATH", "/usr/bin:/bin")
+    try:
+        proc = subprocess.run(
+            cmd,
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+            env=env, timeout=120, check=False)
+    except (OSError, subprocess.TimeoutExpired) as e:
+        send_error(req_id, errno_code(e), "linkodec encode failed", path)
+        return
+    if proc.returncode != 0:
+        message = proc.stderr.decode("utf-8", "replace").strip()
+        send_error(req_id, "ELNKR", message or "linkodec encode failed", path)
+        return
+    code = ""
+    for line in proc.stdout.decode("utf-8", "replace").splitlines():
+        line = line.strip()
+        if line.startswith("#"):
+            code = line
+            break
+    if not code:
+        send_error(req_id, "ELNKR", "linkodec did not return a code", path)
+        return
+    base = "https://app.shel.sh/make/" if code.startswith("#share:") else "https://a.shel.sh/"
+    send_done(req_id, code=code, url=base + code)
+
 
