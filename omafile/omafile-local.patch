diff --git c/bin/omafile-helper w/bin/omafile-helper
index 1eb090d..c1a405d 100755
--- c/bin/omafile-helper
+++ w/bin/omafile-helper
@@ -4299,6 +4299,69 @@ def op_compress(req, cancel_event):
             except OSError:
                 pass
         os.close(pfd)
+TRANSCODE_FORMATS = ("jpg", "png", "mp4", "gif")
+TRANSCODE_RESOLUTIONS = ("high", "medium", "low", "4k", "1080p", "720p")
+
+
+def op_transcode(req, cancel_event):
+    req_id = req["id"]
+    paths = req.get("paths")
+    fmt = req.get("format")
+    res = req.get("resolution")
+    if (not isinstance(paths, list) or not paths
+            or not all(isinstance(p, str) and os.path.isabs(p) for p in paths)
+            or fmt not in TRANSCODE_FORMATS or res not in TRANSCODE_RESOLUTIONS):
+        send_error(req_id, "EINVAL",
+                   "absolute paths, a format (jpg, png, mp4, gif) and a resolution "
+                   "(high, medium, low, 4k, 1080p, 720p) are required")
+        return
+    try:
+        trusted_program("omarchy-transcode")
+    except FileNotFoundError:
+        send_error(req_id, "EUNSUPPORTED", "omarchy-transcode is not installed")
+        return
+    outputs = []
+    for index, raw in enumerate(paths):
+        if cancel_event is not None and cancel_event.is_set():
+            send_error(req_id, "ECANCELED", "cancelled")
+            return
+        path = os.path.normpath(raw)
+        if not os.path.isfile(path):
+            send_error(req_id, "ENOENT", "no such file", path)
+            return
+        emit({"id": req_id, "t": "progress", "files": index, "filesTotal": len(paths),
+              "current": os.path.basename(path)})
+        # The CLI copies its result to the clipboard, which forks a persistent
+        # wl-copy daemon. Running it directly would leave the daemon holding
+        # this helper's stdout/stderr pipes open, so run it through bash with
+        # its stdio redirected to a temp file; the daemon inherits the file
+        # descriptors, not the pipes.
+        errfd, errfile = tempfile.mkstemp(prefix=".omafile-transcode-")
+        os.close(errfd)
+        try:
+            proc = run_trusted("bash", ["-c",
+                "exec omarchy-transcode \"$1\" \"$2\" \"$3\" >\"$4\" 2>&1",
+                "omafile-transcode", path, fmt, res, errfile], timeout=600)
+            message = ""
+            try:
+                with open(errfile, "r", encoding="utf-8", errors="replace") as fh:
+                    message = fh.read().strip()
+            except OSError:
+                pass
+        finally:
+            try:
+                os.unlink(errfile)
+            except OSError:
+                pass
+        if cancel_event is not None and cancel_event.is_set():
+            send_error(req_id, "ECANCELED", "cancelled")
+            return
+        if proc.returncode != 0:
+            send_error(req_id, "ETRANSCODE", message or "transcode failed", path)
+            return
+        stem = os.path.splitext(os.path.basename(path))[0]
+        outputs.append(os.path.join(os.path.dirname(path), stem + "-" + res + "." + fmt))
+    send_done(req_id, outputs=outputs)
 
 
