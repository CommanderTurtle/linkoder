+        statusText = "Ln.kr: hashtag copied"
+      }, function (msg) { statusText = "Ln.kr: " + msg })
+      return
+    }
+    statusText = "Ln.kr: encoding " + name
+    lnkrEncode(entry.path, mode, function (url) {
+      lnkrOpen(url, mode)
+    }, function (msg) { statusText = "Ln.kr: " + msg })
+  }
